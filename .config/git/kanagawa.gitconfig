[delta "kanagawa-wave"]
	blame-palette = "#1F1F28 #2A2A37 #363646 #54546D #727169"
	commit-decoration-style = "#54546D" bold box ul
	dark= true
	file-decoration-style = "#54546D"
	file-style = "#DCD7BA"
	hunk-header-decoration-style = "#54546D" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#54546D"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#54546D"
	line-numbers-minus-style = bold "#C34043"
	line-numbers-plus-style = bold "#76946A"
	line-numbers-right-style = "#54546D"
	line-numbers-zero-style = "#54546D"
	
	# 25% red 75% base
	minus-emph-style = bold syntax "#43242B"
	# 10% red 90% base
	minus-style = syntax "#43242B"
	
	# 25% green 75% base
	plus-emph-style = bold syntax "#2B3328"
	# 10% green 90% base
	plus-style = syntax "#2B3328"
	
	map-styles = \
	bold purple => syntax "#957FB8", \
	bold blue => syntax "#7E9CD8", \
	bold cyan => syntax "#7FB4CA", \
	bold yellow => syntax "#DCA561"
	
	# Should match the name of the bat theme
	syntax-theme = Kanagawa
